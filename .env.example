# Keep the dashboard on this computer unless remote access is deliberately configured.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001

# Required local vault credentials. Use 1–64 numeric digits; replace the example.
DASHBOARD_USER=admin
DASHBOARD_PASS=

# If FLASK_SECRET_KEY is unset, a separate high-entropy session key is generated.
# Set DASHBOARD_COOKIE_SECURE=true only when serving through HTTPS.

# Provider credentials are configured per integration/agent where supported.

# LikePilot creates data/config/credential.key on first credential save.
# Keep that file with your backups; it is required to decrypt stored credentials.

# Optional Chrome major-version override. Leave blank to let undetected-chromedriver detect it.
LIKEPILOT_CHROME_VERSION=
