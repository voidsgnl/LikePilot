# Bind to localhost unless remote access is deliberately configured.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001

# Optional overrides. If DASHBOARD_PASS is blank or unset, LikePilot creates
# a unique password in data/config/dashboard-password on first startup.
DASHBOARD_USER=admin
DASHBOARD_PASS=
# If FLASK_SECRET_KEY is unset, a persistent local session key is generated.
# Set DASHBOARD_COOKIE_SECURE=true when serving through HTTPS.

# Provider credentials are configured per integration/agent where supported.

# LikePilot creates data/config/credential.key on first credential save.
# Keep that file with your backups; it is required to decrypt stored credentials.

# Optional Chrome major-version override. Leave blank to let undetected-chromedriver detect it.
LIKEPILOT_CHROME_VERSION=
